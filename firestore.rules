rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // FONTOS: IDE A SAJÁT GOOGLE FIÓKOD FIREBASE AUTH UID-JA KERÜL!
      return request.auth != null &&
        request.auth.uid == 'IDE_A_SAJAT_ADMIN_UID';
    }
    function validResult() {
      let d = request.resource.data;
      return d.keys().hasAll(['name','category','mode','level','stars','total','playerUid','appVersion','completedAt']) &&
        d.keys().hasOnly(['name','category','mode','level','stars','total','playerUid','appVersion','completedAt']) &&
        d.name is string && d.name.size() >= 2 && d.name.size() <= 60 &&
        d.category in ['practice','cards','review','adventure'] &&
        d.mode in ['order','place','face','real','neighbors','exchange','line','mixed',
                   'digitcards','placecards','exchangecards','neighborcards'] &&
        d.level is int && d.level >= 0 && d.level <= 2 &&
        d.total is int && d.total >= 1 && d.total <= 12 &&
        d.stars is int && d.stars >= 0 && d.stars <= d.total &&
        d.playerUid == request.auth.uid &&
        d.appVersion == 11 && d.completedAt == request.time;
    }
    match /results/{resultId} {
      // A játékos csak ÚJ eredményt írhat; mások eredményei nem olvashatók.
      allow create: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous' && validResult();
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }
    // Minden más adatút alapértelmezetten tiltva.
    match /{document=**} { allow read, write: if false; }
  }
}
